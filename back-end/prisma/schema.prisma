generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model usuarios { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  senha String
  nome  String?
} 

model veterinarios {
  id int @id @default(autoincrement())
  nome String
  cfmv String
  especialidade String
}