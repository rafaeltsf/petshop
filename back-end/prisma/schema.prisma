generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model user { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  senha String
  nome  String?
} 

model veterinario {
  id Int @id @default(autoincrement())
  nome String
  cfmv String
  especialidade String
}

model Pet {
  id              Int       @id @default(autoincrement())
  nome            String
  especie         String
  raca            String?
  dataNascimento  DateTime?
  peso            Float?
  sexo            String?
  observacoes     String?
}